# 环境变量示例：复制成 .env 供你自己的启动方式读取，或者直接在系统里设。
# 所有变量都是可选的，不设置就用括号里的默认值。

# 监听地址与端口（0.0.0.0 / 8765）
VOICE_HOST=0.0.0.0
VOICE_PORT=8765

# 访问令牌：留空 = 不校验（只建议在家里的内网/私有组网里用）。
# 设置后手机端要在 URL 里带 ?token=... 或请求头 X-Token。
VOICE_TOKEN=

# 单文件上限（MB，默认 1024）；一小时以上的语音备忘录常见 200~400MB
VOICE_MAX_UPLOAD_MB=1024

# 识别线程数（默认 2）与单段切分上限秒数（默认 25）
VOICE_THREADS=2
VOICE_MAX_SEC=25

# 转写模式：resident（常驻，快）| per_task（每个任务起子进程，隔离好但慢约 12 秒）
VOICE_WORKER_MODE=resident

# 模型目录（默认 models\ 下的两个 sherpa-onnx 目录，一般不用改）
# VOICE_MODEL_DIR=D:\voice-memo-pipeline\models\sherpa-onnx-paraformer-zh-2024-03-09
# VOICE_PUNCT_DIR=D:\voice-memo-pipeline\models\sherpa-onnx-punct-ct-transformer-zh-en-vocab272727-2024-04-12
# VOICE_CORRECTIONS=D:\voice-memo-pipeline\corrections.txt
